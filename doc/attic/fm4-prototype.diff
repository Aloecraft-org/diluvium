diff -ruN a/src/ldo.c b/src/ldo.c
--- a/src/ldo.c
+++ b/src/ldo.c
@@ -883,6 +883,18 @@
 ** Try to find a suspended protected call (a "recover point") for the
 ** given thread.
 */
+extern const char diluvium_nocatch_key;
+
+static int ldo_nocatch (lua_State *L) {
+  /* No allocation, no lock, no API: the conformance suite's simulated
+     allocation failures found the interning version throwing ERRMEM
+     out of the collector with no handler above it. */
+  TValue k, res;
+  setpvalue(&k, cast_voidp(&diluvium_nocatch_key));
+  return luaH_get(hvalue(&G(L)->l_registry), &k, &res) == LUA_VTRUE;
+}
+
+
 static CallInfo *findpcall (lua_State *L) {
   CallInfo *ci;
   for (ci = L->ci; ci != NULL; ci = ci->previous) {  /* search for a pcall */
@@ -956,7 +968,9 @@
 */
 static TStatus precover (lua_State *L, TStatus status) {
   CallInfo *ci;
-  while (errorstatus(status) && (ci = findpcall(L)) != NULL) {
+  /* Diluvium: past the budget there are no recover points */
+  while (errorstatus(status) && !ldo_nocatch(L) &&
+         (ci = findpcall(L)) != NULL) {
     L->ci = ci;  /* go down to recovery functions */
     setcistrecst(ci, status);  /* status to finish 'pcall' */
     status = luaD_rawrunprotected(L, unroll, NULL);
@@ -1096,6 +1110,12 @@
     luaD_shrinkstack(L);   /* restore stack size in case of overflow */
   }
   L->errfunc = old_errfunc;
+  /* Diluvium: past the budget nothing catches. Re-thrown after the cleanup
+     above, so each level unwinds itself; a finalizer's call (CIST_FIN) and
+     the outermost level (no handler above) keep today's behaviour. */
+  if (l_unlikely(errorstatus(status)) && L->errorJmp != NULL &&
+      !(L->ci->callstatus & CIST_FIN) && ldo_nocatch(L))
+    luaD_throw(L, status);
   return status;
 }
 
