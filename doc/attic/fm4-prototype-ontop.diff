+/* ======================================================================
+** Past the budget, nothing catches
+** ====================================================================== */
+
+/*
+** The count hook raises an ordinary Lua error, and Lua has no other kind. A
+** program that catches it in a loop -- 'while true do pcall(spin) end' --
+** buys DV_HOOK_STEP instructions per catch forever and never returns to the
+** host. So the three same-thread catch sites a guest can reach are replaced
+** here: 'pcall' and 'xpcall' as lbaselib.c writes them but with a
+** continuation that re-raises once the instance is past its budget, and
+** 'load' wrapped so a reader that tripped the budget cannot hand back
+** nil-plus-message. 'coroutine.resume' and 'coroutine.close' need nothing:
+** the catch is on another thread, and the resuming thread trips its own hook
+** outside it (measured: ~110 firings of overrun, then DV_ERROR).
+**
+** The flag is a registry boolean the hook sets on the exceeded path. Written
+** at creation so that setting it never allocates.
+*/
+extern const char diluvium_nocatch_key;   /* real change: declared in lua.h */
+
+static int guest_nocatch (lua_State *L) {
+  int r;
+  lua_rawgetp(L, LUA_REGISTRYINDEX, &diluvium_nocatch_key);
+  r = lua_toboolean(L, -1);
+  lua_pop(L, 1);
+  return r;
+}
+
+static int guest_finishpcall (lua_State *L, int status, lua_KContext extra) {
+  if (l_unlikely(status != LUA_OK && status != LUA_YIELD)) {  /* error? */
+    if (guest_nocatch(L))
+      return lua_error(L);  /* refuse: the error object is on top */
+    lua_pushboolean(L, 0);  /* first result (false) */
+    lua_pushvalue(L, -2);  /* error message */
+    return 2;  /* return false, msg */
+  }
+  else
+    return lua_gettop(L) - (int)extra;  /* return all results */
+}
+
+static int guest_pcall (lua_State *L) {
+  int status;
+  luaL_checkany(L, 1);
+  lua_pushboolean(L, 1);  /* first result if no errors */
+  lua_insert(L, 1);  /* put it in place */
+  status = lua_pcallk(L, lua_gettop(L) - 2, LUA_MULTRET, 0, 0, guest_finishpcall);
+  return guest_finishpcall(L, status, 0);
+}
+
+static int guest_xpcall (lua_State *L) {
+  int status;
+  int n = lua_gettop(L);
+  luaL_checktype(L, 2, LUA_TFUNCTION);  /* check error function */
+  lua_pushboolean(L, 1);  /* first result */
+  lua_pushvalue(L, 1);  /* function */
+  lua_rotate(L, 3, 2);  /* move them below function's arguments */
+  status = lua_pcallk(L, n - 2, LUA_MULTRET, 2, 2, guest_finishpcall);
+  return guest_finishpcall(L, status, 2);
+}
+
+/* The stock 'load' as an upvalue; its fail result is re-raised once past budget. */
+static int guest_load (lua_State *L) {
+  int n;
+  lua_pushvalue(L, lua_upvalueindex(1));
+  lua_insert(L, 1);
+  lua_call(L, lua_gettop(L) - 1, LUA_MULTRET);
+  n = lua_gettop(L);
+  if (n >= 2 && lua_isnil(L, 1) && guest_nocatch(L)) {
+    lua_settop(L, 2);
+    return lua_error(L);
+  }
+  return n;
+}
+
+static void install_nocatch (lua_State *L) {
+  lua_pushboolean(L, 0);
+  lua_rawsetp(L, LUA_REGISTRYINDEX, &diluvium_nocatch_key);
+  lua_pushcfunction(L, guest_pcall);
+  lua_setglobal(L, "pcall");
+  lua_pushcfunction(L, guest_xpcall);
+  lua_setglobal(L, "xpcall");
+  lua_getglobal(L, "load");
+  lua_pushcclosure(L, guest_load, 1);
+  lua_setglobal(L, "load");
+  /* Named directly, unlike lbaselib.c's, whose address is only discoverable. */
+  diluvium_shim_addcont("dlibs.pcall", guest_finishpcall);
+}
+
+
 LUA_API void diluvium_openguestlibs (lua_State *L, unsigned int flags) {
   int load = ~0;
   if (!(flags & DILUVIUM_GUEST_UNSAFE_STDLIB))
@@ -251,5 +342,6 @@
   }
   if (!(flags & DILUVIUM_GUEST_UNSAFE_STDLIB))
     seal_base(L);
+  install_nocatch(L);
   diluvium_openlibs(L);
 }
diff -ruN a/src/dshim.c b/src/dshim.c
--- a/src/dshim.c
+++ b/src/dshim.c
@@ -37,6 +37,7 @@
 
 #include "lua.h"
 
+#include "ldo.h"
 #include "lfunc.h"
 #include "lgc.h"
 #include "lobject.h"
@@ -835,3 +836,17 @@
   dsync_lock_release(&dshim_contlock);
   return found;
 }
+
+
+/*
+** Raise the value on top of 'L' as an error without running any message
+** handler. 'lua_error' goes through 'luaG_errormsg', which calls the handler
+** installed by the innermost 'xpcall' -- and a hook raises with 'allowhook'
+** off, so a handler that spins there runs unbudgeted. The budget's raise has
+** no business consulting a handler at all: nothing may catch it, so nothing
+** gets to decorate it.
+*/
+LUA_API void diluvium_shim_throw (lua_State *L) {
+  lua_lock(L);   /* as 'lua_error' does: the catcher unlocks */
+  luaD_throw(L, LUA_ERRRUN);
+}
