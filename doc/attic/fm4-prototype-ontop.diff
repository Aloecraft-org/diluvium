diff -ruN a/src/lgc.c b/src/lgc.c
--- a/src/lgc.c
+++ b/src/lgc.c
@@ -965,6 +965,20 @@
 }
 
 
+/* Diluvium: registry["diluvium.nocatch"], read without the API or the lock. */
+/* The kill flag's registry key: its address is the key. */
+const char diluvium_nocatch_key = 0;
+
+static int lgc_nocatch (lua_State *L) {
+  /* No allocation, no lock, no API: the conformance suite's simulated
+     allocation failures found the interning version throwing ERRMEM
+     out of the collector with no handler above it. */
+  TValue k, res;
+  setpvalue(&k, cast_voidp(&diluvium_nocatch_key));
+  return luaH_get(hvalue(&G(L)->l_registry), &k, &res) == LUA_VTRUE;
+}
+
+
