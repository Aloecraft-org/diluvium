{
  "name": "diluvium",
  "displayName": "Diluvium",
  "description": "Language support for Diluvium (.dlua) — Lua with string interpolation, null coalescing, switch, defer, with, safe navigation and more.",
  "version": "0.1.0",
  "publisher": "aloecraft",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aloecraft-org/diluvium"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "diluvium",
    "dlua",
    "lua"
  ],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "dlua",
        "aliases": [
          "Diluvium",
          "dlua"
        ],
        "extensions": [
          ".dlua"
        ],
        "filenamePatterns": [
          "*.host.lua"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "dlua",
        "scopeName": "source.dlua",
        "path": "./syntaxes/dlua.tmLanguage.json"
      }
    ]
  }
}
